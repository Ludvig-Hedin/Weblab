    )],\\n    [\\"/detail_project\\", (children, script) => (\\n        <html {...{\\"data-wf-site\\":\\"site\\",\\"data-wf-page\\":\\"cms\\"}} lang=\\"en\\" className={[\\"\\", fontClasses].filter(Boolean).join(\\" \\")}>\\n            <head></head>\\n            <body>\\n                {children}\\n                {[].map(script)}\\n            </body>\\n        </html>\\n    )],\\n    [\\"/work\\", (children, script) => (\\n        <html {...{\\"data-wf-site\\":\\"site\\",\\"data-wf-page\\":\\"work\\"}} lang=\\"en\\" className={[\\"\\", fontClasses].filter(Boolean).join(\\" \\")}>\\n            <head>\\n                <link rel=\\"stylesheet\\" href=\\"/css/normalize.css\\" />\\n                <link rel=\\"stylesheet\\" href=\\"/css/webflow.css\\" />\\n                <link rel=\\"stylesheet\\" href=\\"/css/studio.webflow.css\\" />\\n            </head>\\n            <body className=\\"work\\">\\n                {siteChrome(children)}\\n                {[2,1].map(script)}\\n            </body>\\n        </html>\\n    )],\\n]);\\n\\nexport default async function RootLayout({ children }: { children: ReactNode }) {\\n    const path = (await headers()).get(\\"x-webflow-import-path\\") ?? \\"/\\";\\n    const layout = layouts.get(path) ?? layouts.values().next().value!;\\n    return layout(children, (index) => scripts[index]);\\n}\\n"

{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "bun"]
    },
    "include": ["**/*.js", "scripts/**/*.mjs"],
    "exclude": ["node_modules", "dist", ".runtime"]
}

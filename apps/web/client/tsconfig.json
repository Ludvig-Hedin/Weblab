{
    "extends": "@weblab/typescript/next-react.json",
    "compilerOptions": {
        "baseUrl": ".",
        "allowArbitraryExtensions": true,
        "paths": {
            "@/*": ["./src/*"],
            "/*": ["./*"],
            "~/*": ["./src/*"],
            "@convex/*": ["./convex/*"]
        }
    },
    "include": [
        "src",
        "middleware.ts",
        "tests",
        ".next/types/**/*.ts",
        "messages/en.d.json.ts",
        "../../../packages/file-system/src/code-fs.ts"
    ],
    "exclude": ["node_modules", ".next"]
}
